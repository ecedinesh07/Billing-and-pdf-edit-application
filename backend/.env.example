APP_NAME=Document Text Correction Engine
DEBUG=true
API_PREFIX=/api/v1
# npm run backend reads .env.local and leaves this unset (SQLite).
# npm run backend:dev reads .env.dev and sets the Neon URL below.
# The app rewrites a postgresql:// URL for asyncpg. Set DATABASE_URL_UNPOOLED to the direct Neon URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
CORS_ORIGINS=http://localhost:4200
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50
TEMP_FILE_RETENTION_HOURS=24

