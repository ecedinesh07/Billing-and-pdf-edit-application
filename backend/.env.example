APP_NAME=Document Text Correction Engine
DEBUG=true
API_PREFIX=/api/v1
# Leave unset to use local SQLite under backend/storage/docedit.db.
# Production uses the pooled Neon URL (postgresql://...-pooler.../neondb). The app
# rewrites it for asyncpg. Set DATABASE_URL_UNPOOLED to the direct Neon URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
CORS_ORIGINS=http://localhost:4200
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50
TEMP_FILE_RETENTION_HOURS=24

